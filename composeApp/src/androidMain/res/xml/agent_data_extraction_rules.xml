<?xml version="1.0" encoding="utf-8"?>
<!-- The app already disables backup (allowBackup=false). On Android 12+ this also keeps the
     in-app assistant's encrypted keys, settings and conversations out of device-to-device transfer. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="nuvio_agent_secrets.xml" />
        <exclude domain="sharedpref" path="nuvio_agent_config.xml" />
        <exclude domain="sharedpref" path="nuvio_agent_memory.xml" />
        <exclude domain="file" path="agent/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="nuvio_agent_secrets.xml" />
        <exclude domain="sharedpref" path="nuvio_agent_config.xml" />
        <exclude domain="sharedpref" path="nuvio_agent_memory.xml" />
        <exclude domain="file" path="agent/" />
    </device-transfer>
</data-extraction-rules>
